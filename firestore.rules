rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ads/{adId} {
      function validAd() {
        return request.resource.data.keys().hasAll([
            'ownerUid', 'title', 'body', 'links', 'noteColor',
            'published', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000
          && request.resource.data.noteColor in [
            'yellow', 'mint', 'pink', 'blue', 'lilac'
          ]
          && request.resource.data.published is bool
          && request.resource.data.links is list
          && request.resource.data.links.size() <= 10;
      }

      allow read: if resource.data.published == true
        || (request.auth != null && request.auth.uid == resource.data.ownerUid);

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && validAd();

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validAd();

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /trips/{tripId} {
      function isTripOwner() {
        return request.auth != null
          && request.auth.uid == resource.data.ownerUid;
      }

      function validTrip() {
        return request.resource.data.keys().hasAll([
            'ownerUid', 'title', 'note', 'people', 'expenses',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.ownerUid is string
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.people is list
          && request.resource.data.people.size() <= 30
          && request.resource.data.expenses is list
          && request.resource.data.expenses.size() <= 200
          && (
            !request.resource.data.keys().hasAny(['paidPayments'])
            || (
              request.resource.data.paidPayments is list
              && request.resource.data.paidPayments.size() <= 30
            )
          )
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string;
      }

      allow get: if true;

      allow list: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && validTrip();

      allow update: if isTripOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validTrip();

      allow delete: if isTripOwner();
    }

    // ---------------------------------------------------------------------
    // mindset
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isMindsetOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function docPath(collection, id) {
      return /databases/$(database)/documents/$(collection)/$(id);
    }

    function inSchoolOf(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/schools/$(uid)/members/$(request.auth.uid));
    }

    // Pair ids are "{fromUid}_{toUid}". Uids are alphanumeric. Either side may touch the pair.
    function pairTouchesMe(pairId) {
      return signedIn()
        && (
          pairId.matches('^' + request.auth.uid + '_[A-Za-z0-9]+$')
          || pairId.matches('^[A-Za-z0-9]+_' + request.auth.uid + '$')
        );
    }

    // Root is the owner of mindset 1 ("firstfish"). Test fish ("sim12") have no
    // account: root writes on their behalf, and only for them.
    function isRoot() {
      return signedIn() && get(docPath('mindsets', '1')).data.ownerUid == request.auth.uid;
    }

    function isSim(uid) {
      return uid is string && uid.matches('^sim[0-9]+$');
    }

    function actor(uid) {
      return signedIn() && (request.auth.uid == uid || (isSim(uid) && isRoot()));
    }

    function ownsMindsetFor(uid, number) {
      return get(docPath('mindsets', string(number))).data.ownerUid == uid;
    }

    function rootTouchesSim(pairId) {
      return isRoot()
        && (pairId.matches('^sim[0-9]+_[A-Za-z0-9]+$') || pairId.matches('^[A-Za-z0-9]+_sim[0-9]+$'));
    }

    function closedField(name) {
      return name in ['unsayableAttitude', 'desireScript', 'disownedSelf'];
    }

    // A shown field must be a verbatim copy of the owner's own closed text.
    function ownClosedText(number, field) {
      return get(docPath('privateMindsets', string(number))).data[field];
    }

    function ownsMindset(number) {
      return get(docPath('mindsets', string(number))).data.ownerUid == request.auth.uid;
    }

    function score(value) {
      return value is int && value >= -1 && value <= 100;
    }

    function shortText(value) {
      return value is string && value.size() <= 1200;
    }

    function isoTime(value) {
      return value is string && value.size() >= 20 && value.size() <= 40;
    }

    function aliasName(value) {
      return value is string && value.matches('^[a-z0-9_]{3,20}$');
    }

    function buckets(value) {
      return value.keys().hasOnly(['b0', 'b1', 'b2', 'b3', 'b4']);
    }

    function validDemographics(data) {
      return data.get('ageBand', '') in ['', '18-24', '25-34', '35-44', '45-54', '55-64', '65+']
        && data.get('gender', '') in ['', 'woman', 'man', 'nonbinary', 'other']
        && data.get('country', '') is string
        && data.get('country', '').matches('^([A-Z]{2})?$');
    }

    function ownsMindsetAfter(number) {
      return getAfter(docPath('mindsets', string(number))).data.ownerUid == request.auth.uid;
    }

    function openScores(data) {
      return score(data.agency)
        && score(data.communion)
        && score(data.codeClarity)
        && score(data.redemption)
        && data.known is list
        && data.known.size() <= 4
        && data.known.hasOnly(['agency', 'communion', 'codeClarity', 'redemption']);
    }

    function openTexts(data) {
      return shortText(data.currentPosition)
        && shortText(data.personalCode)
        && data.personalCode.size() > 0
        && shortText(data.selfNarrative);
    }

    // Aliases never sit on the public document; outsiders only ever see numbers.
    function validPublic(mindsetId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'ownerUid', 'number', 'numberKey', 'published', 'createdAt', 'updatedAt',
          'lens', 'agency', 'communion', 'codeClarity', 'redemption', 'known', 'bucket',
          'ageBand', 'gender', 'country', 'history', 'seed',
          'currentPosition', 'personalCode', 'selfNarrative', 'headline', 'blurb'
        ])
        && shortText(data.get('headline', ''))
        && shortText(data.get('blurb', ''))
        && data.ownerUid == request.auth.uid
        && data.number is int
        && data.number > 0
        && mindsetId.matches('^\\d+$')
        && data.numberKey == mindsetId
        && data.published is bool
        && data.lens in ['v1', 'v2']
        && isoTime(data.createdAt)
        && isoTime(data.updatedAt)
        && openScores(data)
        && data.bucket is string
        && data.bucket.matches('^[0-4u]{4}$')
        && validDemographics(data)
        && data.get('history', 'none') in ['none', 'tribe', 'school', 'public']
        && (!('seed' in data) || data.seed == true)
        && openTexts(data);
    }

    // A version is a frozen copy of the open side of one reading.
    function validVersion(mindsetId, versionId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'ownerUid', 'number', 'createdAt', 'lens',
          'agency', 'communion', 'codeClarity', 'redemption', 'known',
          'ageBand', 'gender', 'country',
          'currentPosition', 'personalCode', 'selfNarrative', 'headline', 'blurb'
        ])
        && shortText(data.get('headline', ''))
        && shortText(data.get('blurb', ''))
        && versionId.matches('^\\d{14,20}$')
        && data.ownerUid == request.auth.uid
        && data.number is int
        && string(data.number) == mindsetId
        && data.lens in ['v1', 'v2']
        && isoTime(data.createdAt)
        && openScores(data)
        && validDemographics(data)
        && openTexts(data);
    }

    function canSeeHistory(mindsetId) {
      let parent = get(docPath('mindsets', mindsetId)).data;
      return (signedIn() && parent.ownerUid == request.auth.uid)
        || (parent.published == true && parent.get('history', 'none') == 'public')
        || (parent.published == true && parent.get('history', 'none') in ['tribe', 'school'] && inSchoolOf(parent.ownerUid));
    }

    function validPrivate(privateId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'ownerUid', 'number', 'numberKey', 'lens', 'updatedAt', 'city',
          'unsayableAttitude', 'desireScript', 'disownedSelf',
          'codeGap', 'authorityLean', 'desireSplit', 'shadowDistance'
        ])
        && data.ownerUid == request.auth.uid
        && data.number is int
        && data.number > 0
        && privateId.matches('^\\d+$')
        && data.numberKey == privateId
        && data.lens in ['v1', 'v2']
        && isoTime(data.updatedAt)
        && data.get('city', '') is string
        && data.get('city', '').size() <= 60
        && shortText(data.unsayableAttitude)
        && shortText(data.desireScript)
        && shortText(data.disownedSelf)
        && score(data.codeGap)
        && score(data.authorityLean)
        && score(data.desireSplit)
        && score(data.shadowDistance);
    }

    match /mindsets/{mindsetId} {
      allow read: if resource.data.published == true
        || (signedIn() && request.auth.uid == resource.data.ownerUid);

      allow create: if signedIn() && validPublic(mindsetId);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.number == resource.data.number
        && request.resource.data.numberKey == resource.data.numberKey
        && request.resource.data.createdAt == resource.data.createdAt
        && validPublic(mindsetId);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /versions/{versionId} {
        allow read: if canSeeHistory(mindsetId);

        allow create: if signedIn()
          && ownsMindsetAfter(mindsetId)
          && validVersion(mindsetId, versionId);

        allow update: if false;

        allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      }
    }

    match /privateMindsets/{privateId} {
      allow get: if signedIn()
        && (request.auth.uid == resource.data.ownerUid || (isRoot() && isSim(resource.data.ownerUid)));
      allow list: if false;

      allow create: if signedIn() && validPrivate(privateId);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.number == resource.data.number
        && request.resource.data.numberKey == resource.data.numberKey
        && validPrivate(privateId);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /owners/{uid} {
      allow get: if isMindsetOwner(uid);
      allow list: if false;

      allow create, update: if isMindsetOwner(uid)
        && request.resource.data.keys().hasOnly(['number'])
        && request.resource.data.number is int
        && request.resource.data.number > 0;

      allow delete: if isMindsetOwner(uid);
    }

    match /counters/{counterId} {
      allow get: if signedIn() && counterId == 'mindset';
      allow list: if false;

      allow create: if signedIn()
        && counterId == 'mindset'
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next > 0
        && request.resource.data.next < 10000000;

      allow update: if signedIn()
        && counterId == 'mindset'
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next > resource.data.next
        && request.resource.data.next <= resource.data.next + 8;

      allow delete: if false;
    }

    match /stats/{statId} {
      allow get: if statId == 'public';
      allow list: if false;

      allow create, update: if signedIn()
        && statId == 'public'
        && request.resource.data.keys().hasOnly([
          'lens', 'count', 'axes', 'byAge', 'byGender', 'byCountry', 'cities'
        ])
        && request.resource.data.lens in ['v1', 'v2']
        && request.resource.data.get('count', 0) is int
        && request.resource.data.axes.keys().hasOnly(['agency', 'communion', 'codeClarity', 'redemption'])
        && (!('agency' in request.resource.data.axes) || buckets(request.resource.data.axes.agency))
        && (!('communion' in request.resource.data.axes) || buckets(request.resource.data.axes.communion))
        && (!('codeClarity' in request.resource.data.axes) || buckets(request.resource.data.axes.codeClarity))
        && (!('redemption' in request.resource.data.axes) || buckets(request.resource.data.axes.redemption))
        && request.resource.data.get('byAge', {}).keys().hasOnly([
          'a18_24', 'a25_34', 'a35_44', 'a45_54', 'a55_64', 'a65p'
        ])
        && request.resource.data.get('byGender', {}).keys().hasOnly([
          'woman', 'man', 'nonbinary', 'other'
        ])
        && request.resource.data.get('byCountry', {}).size() <= 260
        && request.resource.data.get('cities', {}).size() <= 5000;

      allow delete: if false;
    }

    // The four closed readings (scores only, never texts) are copied here so the
    // school can see the full radar. Only the owner and their school can read it.
    match /deepReadings/{numberId} {
      allow get: if signedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || inSchoolOf(resource.data.ownerUid)
          || (isRoot() && isSim(resource.data.ownerUid))
        );
      allow list: if false;

      allow create, update: if signedIn()
        && numberId.matches('^\\d+$')
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'number', 'updatedAt',
          'codeGap', 'authorityLean', 'desireSplit', 'shadowDistance'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.number is int
        && string(request.resource.data.number) == numberId
        && ownsMindset(request.resource.data.number)
        && isoTime(request.resource.data.updatedAt)
        && score(request.resource.data.codeGap)
        && score(request.resource.data.authorityLean)
        && score(request.resource.data.desireSplit)
        && score(request.resource.data.shadowDistance);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Alias ids are the alias itself, so uniqueness comes from the document id.
    // Only the owner and their school can read one; "firstfish" belongs to mindset 1.
    match /aliases/{aliasId} {
      allow get: if resource == null
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || inSchoolOf(resource.data.ownerUid);
      allow list: if false;

      allow create, update: if signedIn()
        && aliasName(aliasId)
        && (aliasId != 'firstfish' || request.resource.data.number == 1)
        && (resource == null || resource.data.ownerUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'number'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.number is int
        && ownsMindsetAfter(request.resource.data.number)
        && getAfter(docPath('aliasOf', string(request.resource.data.number))).data.alias == aliasId;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /aliasOf/{numberId} {
      allow get: if resource == null
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || inSchoolOf(resource.data.ownerUid);
      allow list: if false;

      allow create, update: if signedIn()
        && numberId.matches('^\\d+$')
        && (resource == null || resource.data.ownerUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'alias'])
        && request.resource.data.ownerUid == request.auth.uid
        && aliasName(request.resource.data.alias)
        && ownsMindsetAfter(numberId)
        && getAfter(docPath('aliases', request.resource.data.alias)).data.ownerUid == request.auth.uid;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Step 1. A swims after B: "tails/{A}_{B}". B sees it on the current screen.
    match /tails/{tailId} {
      allow get: if pairTouchesMe(tailId) || isRoot();
      allow list: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isRoot());

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromNumber', 'toNumber', 'createdAt'])
        && actor(request.resource.data.from)
        && request.resource.data.to is string
        && request.resource.data.to != request.resource.data.from
        && tailId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.fromNumber is int
        && request.resource.data.toNumber is int
        && ownsMindsetFor(request.resource.data.from, request.resource.data.fromNumber)
        && get(docPath('mindsets', string(request.resource.data.toNumber))).data.ownerUid == request.resource.data.to
        && isoTime(request.resource.data.createdAt);

      allow update: if false;
      allow delete: if pairTouchesMe(tailId) || rootTouchesSim(tailId);
    }

    // Step 2. B shines a scale for A: "glints/{B}_{A}". One closed field, copied
    // verbatim, readable by A for at most seven days (or for good once they are a school).
    match /glints/{glintId} {
      allow get: if signedIn()
        && (
          resource.data.from == request.auth.uid
          || (
            resource.data.to == request.auth.uid
            && (resource.data.expiresAt > request.time || inSchoolOf(resource.data.from))
          )
          || (isRoot() && (isSim(resource.data.from) || isSim(resource.data.to)))
        );
      allow list: if signedIn() && resource.data.from == request.auth.uid;

      allow create, update: if signedIn()
        && (resource == null || actor(resource.data.from))
        && request.resource.data.keys().hasOnly([
          'from', 'to', 'fromNumber', 'toNumber', 'field', 'text', 'createdAt', 'expiresAt'
        ])
        && actor(request.resource.data.from)
        && request.resource.data.to is string
        && glintId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.fromNumber is int
        && request.resource.data.toNumber is int
        && ownsMindsetFor(request.resource.data.from, request.resource.data.fromNumber)
        && exists(docPath('tails', request.resource.data.to + '_' + request.resource.data.from))
        && closedField(request.resource.data.field)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1200
        && request.resource.data.text == ownClosedText(request.resource.data.fromNumber, request.resource.data.field)
        && isoTime(request.resource.data.createdAt)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');

      allow delete: if pairTouchesMe(glintId) || rootTouchesSim(glintId);
    }

    // Step 3. A seals one closed field as a pledge: "seals/{A}_{B}". B can read
    // it only after the school exists.
    match /seals/{sealId} {
      allow get: if signedIn()
        && (
          resource.data.from == request.auth.uid
          || (resource.data.to == request.auth.uid && inSchoolOf(resource.data.from))
          || (isRoot() && (isSim(resource.data.from) || isSim(resource.data.to)))
        );
      allow list: if false;

      allow create, update: if signedIn()
        && (resource == null || actor(resource.data.from))
        && request.resource.data.keys().hasOnly([
          'from', 'to', 'fromNumber', 'toNumber', 'field', 'text', 'createdAt'
        ])
        && actor(request.resource.data.from)
        && request.resource.data.to is string
        && sealId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.fromNumber is int
        && request.resource.data.toNumber is int
        && ownsMindsetFor(request.resource.data.from, request.resource.data.fromNumber)
        && existsAfter(docPath('schoolRequests', sealId))
        && closedField(request.resource.data.field)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1200
        && request.resource.data.text == ownClosedText(request.resource.data.fromNumber, request.resource.data.field)
        && isoTime(request.resource.data.createdAt);

      allow delete: if pairTouchesMe(sealId) || rootTouchesSim(sealId);
    }

    // A asks B to join a school: "schoolRequests/{A}_{B}". Only possible after B
    // showed A a scale, and only together with A's sealed pledge.
    match /schoolRequests/{requestId} {
      allow get: if pairTouchesMe(requestId) || isRoot();
      allow list: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isRoot());

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromNumber', 'toNumber', 'field', 'createdAt'])
        && actor(request.resource.data.from)
        && request.resource.data.to is string
        && request.resource.data.to != request.resource.data.from
        && requestId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.fromNumber is int
        && request.resource.data.toNumber is int
        && ownsMindsetFor(request.resource.data.from, request.resource.data.fromNumber)
        && get(docPath('mindsets', string(request.resource.data.toNumber))).data.ownerUid == request.resource.data.to
        && closedField(request.resource.data.field)
        && exists(docPath('glints', request.resource.data.to + '_' + request.resource.data.from))
        && get(docPath('glints', request.resource.data.to + '_' + request.resource.data.from)).data.expiresAt > request.time
        && existsAfter(docPath('seals', requestId))
        && getAfter(docPath('seals', requestId)).data.field == request.resource.data.field
        && !exists(/databases/$(database)/documents/schools/$(request.resource.data.from)/members/$(request.resource.data.to))
        && isoTime(request.resource.data.createdAt);

      allow update: if false;
      allow delete: if pairTouchesMe(requestId) || rootTouchesSim(requestId);
    }

    // Both sides write the membership, only when the request exists.
    match /schools/{uid}/members/{otherUid} {
      allow get: if signedIn()
        && (request.auth.uid == uid || request.auth.uid == otherUid || inSchoolOf(uid));
      allow list: if signedIn() && (request.auth.uid == uid || inSchoolOf(uid));

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'number', 'since'])
        && request.resource.data.uid == otherUid
        && request.resource.data.number is int
        && isoTime(request.resource.data.since)
        && (
          (
            actor(uid)
            && exists(docPath('schoolRequests', otherUid + '_' + uid))
            && request.resource.data.number == get(docPath('schoolRequests', otherUid + '_' + uid)).data.fromNumber
          )
          || (
            actor(otherUid)
            && exists(docPath('schoolRequests', uid + '_' + otherUid))
            && request.resource.data.number == get(docPath('schoolRequests', uid + '_' + otherUid)).data.toNumber
          )
        );

      allow update: if false;

      allow delete: if signedIn()
        && (request.auth.uid == uid || request.auth.uid == otherUid || (isRoot() && (isSim(uid) || isSim(otherUid))));
    }

    // Root counts every school across the lake (only uid, number and date live here).
    match /{path=**}/members/{otherUid} {
      allow list: if isRoot();
    }

    // Root-only: simulation state and the per-cycle log.
    match /sim/{id} {
      allow read, write: if isRoot();
    }

    match /simTicks/{id} {
      allow read, write: if isRoot();
    }
  }
}
